# 监听地址。放在反向代理后面时改成 127.0.0.1
HOST=0.0.0.0
PORT=28787

# 后台密码（可选；不填的话首次启动自动生成一个强随机密码，
# 打印在启动日志里并保存到 data/.admin-password，以后重启不变）
# ADMIN_PASSWORD=

# 上游账号信息的加密密钥（不填会自动生成并保存到 data/.secret）
# APP_SECRET=

# 数据目录
# DATA_DIR=./data

# ---- 仅 Docker 部署使用 ----
# 镜像地址（GitHub Actions 自动构建推送；可改成 :sha-xxxxxxx 或 :1.2.3 锁定版本）
# IMAGE=ghcr.io/jsxiaojun/pelican-mirror:latest
# 宿主机对外端口（容器内部固定 28787，上面的 HOST/PORT/DATA_DIR 在容器里会被覆盖）
# HOST_PORT=28787

# 部署在 Nginx/Caddy 后面时设为 1（信任 X-Forwarded-For / X-Forwarded-Proto）
TRUST_PROXY=0
